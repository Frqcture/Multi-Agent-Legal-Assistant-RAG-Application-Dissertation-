@startuml basicStructure
' basicStructure.uml - simplified high-level architecture diagram

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Courier
skinparam defaultFontSize 11

' ============= FRONTEND =============
package "Frontend (React/Vite)" {
  [Login] as FE_Login
  [Register] as FE_Register
  [Search] as FE_Search
  [useAuth Hook] as FE_Auth
}

' ============= BACKEND API =============
package "Backend API (FastAPI)" {
  [Auth Endpoints] as BE_AuthEP
  [Query Endpoint] as BE_QueryEP
  [Upload Endpoint] as BE_UploadEP
  [File Management] as BE_FileMgmt
}

' ============= BACKEND SERVICES =============
package "Backend Services" {
  [Authentication] as BE_AuthSvc
  [RAG Engine] as BE_RAGSvc
  [Ingestion Pipeline] as BE_IngestSvc
}

' ============= STORAGE =============
package "Storage" {
  [User Database] as STORE_Users
  [Vector Database] as STORE_Vectors
  [Document Cache] as STORE_Docs
}

' ============= EXTERNAL =============
package "External Services" {
  [Ollama LLM] as EXT_LLM
  [Ollama Embeddings] as EXT_EMB
  [OCR Tools] as EXT_OCR
}

' ============= FRONTEND ROUTING =============
FE_Auth --> FE_Login : not authenticated
FE_Auth --> FE_Register : new user
FE_Auth --> FE_Search : authenticated

' ============= FRONTEND -> API =============
FE_Login --> BE_AuthEP : POST /login
FE_Register --> BE_AuthEP : POST /register
FE_Search --> BE_AuthEP : GET /me
FE_Search --> BE_QueryEP : POST /ask
FE_Search --> BE_UploadEP : POST /upload
FE_Search --> BE_FileMgmt : GET/DELETE /files

' ============= API -> SERVICES =============
BE_AuthEP --> BE_AuthSvc : auth logic
BE_QueryEP --> BE_RAGSvc : query knowledge
BE_UploadEP --> BE_IngestSvc : process docs
BE_FileMgmt --> BE_RAGSvc : manage vectors

' ============= SERVICES -> STORAGE =============
BE_AuthSvc --> STORE_Users : user credentials
BE_RAGSvc --> STORE_Vectors : retrieve/store chunks
BE_IngestSvc --> STORE_Docs : cache source files
BE_IngestSvc --> STORE_Vectors : add new vectors

' ============= SERVICES -> EXTERNAL =============
BE_RAGSvc --> EXT_LLM : generate answers
BE_RAGSvc --> EXT_EMB : embed queries
BE_IngestSvc --> EXT_EMB : embed documents
BE_IngestSvc --> EXT_OCR : extract text

@enduml

@startuml RAG Application Architecture

top to bottom direction
skinparam componentStyle rectangle
skinparam linetype polyline
skinparam nodesep 80
skinparam ranksep 100

' ====================
' LAYER 1: PRESENTATION
' ====================
package "Frontend Layer (React + TypeScript + Vite)"{
    component [Login Component] as Login
    component [Register Component] as Register
    component [Search Interface] as Search
    component [Workflow Monitor] as Workflow
    
    component [useAuth Hook\n--\nToken Storage\nAuth State] as AuthHook
    
    note right of Search
        Real-time search with
        streaming responses
    end note
}

' ====================
' LAYER 2: API GATEWAY
' ====================
package "API Gateway Layer (FastAPI + Python)" {
    interface "REST Endpoints" as REST
    
    component [FastAPI Router\n--\nPOST /register\nPOST /login\nPOST /search\nPOST /upload\nPOST /workflow\nGET /status] as API
    
    component [Auth Middleware\n--\nJWT Validation\nOAuth2 Bearer\nToken Refresh] as AuthMiddleware
    
    component [Security Utils\n--\nBcrypt Hashing\nJWT Encode/Decode\nRate Limiting] as AuthUtils
    
    note bottom of API
        CORS enabled for
        localhost:5173
    end note
}

' ====================
' LAYER 3A: QUERY PROCESSING PATH
' ====================
package "Query Processing Path" {
    component [Multi-Agent\nCoordinator\n--\n<b>Planner Agent</b>\nAnalyzes user query\n--\n<b>Retriever Agent</b>\nFetches relevant docs\n--\n<b>Responder Agent</b>\nGenerates final answer] as Coordinator
    
    component [MCP Server\n--\nJSON-RPC over stdio\nTool Registry\nAsync Handler] as MCP
    
    component [RAG Engine\n--\nQuery Pipeline\nPrompt Templates\nContext Formatting\nMetadata Filtering] as RAGEngine
    
    note right of Coordinator
        Workflow tracking with
        session IDs and step logging
    end note
}

' ====================
' LAYER 3B: UPLOAD PROCESSING PATH
' ====================
package "Document Processing Path" {
    component [Ingestion Pipeline\n--\n1. PDF Loader (PyPDF)\n2. Text Splitter (1000 char chunks)\n3. Metadata Extraction\n4. User ID Tagging] as Ingestion
    
    component [OCR Processor\n--\nImage Extraction\nText Recognition\nLayout Analysis] as OCR
    
    note left of Ingestion
        15MB max file size
        Supports: PDF, images
    end note
}

' ====================
' LAYER 4: DATA & MODELS
' ====================

package "Data Layer" {
    database "User Database\n(SQLite/PostgreSQL)\n--\n<b>Users Table</b>\n• id (PK)\n• username\n• email\n• hashed_password\n• created_at" as UserDB
    
    database "Vector Database\n(ChromaDB)\n--\n<b>Collections</b>\n• Document embeddings\n• Page metadata\n• User ownership\n--\n<b>Indexes</b>\nSemantic similarity (HNSW)" as VectorDB
    
    folder "Upload Directory\n./DocsToIngest/" as Docs
}

cloud "External: Ollama Service\n--\n<b>LLM:</b> gemma3:4b\n<b>Embeddings:</b> embeddinggemma\n--\nHTTP API (localhost:11434)" as Ollama

' ====================
' VERTICAL FLOW: Frontend -> API -> Processing -> Data
' ====================

' Layer 1 to Layer 2
Login -down-> REST : "POST /login"
Register -down-> REST : "POST /register"
Search -down-> REST : "POST /search\nPOST /workflow"
Workflow -down-> REST : "GET /status"

AuthHook .down.> REST : "Bearer Token"

' Layer 2 internal
REST -down- API
API -right-> AuthMiddleware
AuthMiddleware -right-> AuthUtils

' Layer 2 to Layer 3 - Split paths
API -down-> Coordinator : "Initiate Query\n(user_id, query)"
API -down-> Ingestion : "Upload File\n(PDF + user_id)"
API -down-> UserDB : "Auth & User Mgmt"

' Layer 3A: Query Path
Coordinator -down-> MCP : "Subprocess\nCommunication"
MCP -down-> RAGEngine : "search_docs()\nget_context()"
RAGEngine -down-> VectorDB : "Similarity Search\n+ User Filter"

' Layer 3B: Upload Path
Ingestion -left-> OCR : "Extract Text\nfrom Images"
Ingestion -down-> VectorDB : "Store Embeddings\n+ Metadata"
Docs -down-> Ingestion : "Source Files"

' External service connections
RAGEngine -right-> Ollama : "LLM Completion\n(streaming)"
Ingestion -right-> Ollama : "Generate\nEmbeddings"
VectorDB .right.> Ollama : "Vector\nGeneration"

' ====================
' ADDITIONAL FLOWS
' ====================

MCP .up.> Coordinator : "Tool Results\n(JSON-RPC response)"

' ====================
' TECHNOLOGY NOTES
' ====================

note bottom of VectorDB
    <b>User Isolation:</b>
    Metadata filtering ensures
    users only access their docs
    
    <b>Persistence:</b>
    SQLite-backed vector store
end note

legend right
    |= Technology Stack |
    | Frontend | React 18 + TypeScript + Vite |
    | Backend | FastAPI + Uvicorn |
    | Agents | LangChain + Ollama |
    | Database | SQLite + ChromaDB |
    | Auth | JWT + Bcrypt |
endlegend

@enduml
